# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rubway

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Admin authentication
ADMIN_USERNAME=admin
# Generate a password hash with the same password-hashing library used by the backend.
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Telegram integration (optional for local development)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
